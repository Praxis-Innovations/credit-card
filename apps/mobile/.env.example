# Local Supabase (from `npx supabase start` output)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# NorthTap public API (apps/api)
# EXPO_PUBLIC_NORTHTAP_API_KEY must hash-match the internal row in
# supabase/migrations/*_seed_catalog.sql (public.api_keys).
# Set the real value in .env.local / Vercel env vars — never commit it here.
EXPO_PUBLIC_NORTHTAP_API_URL=http://localhost:8787
EXPO_PUBLIC_NORTHTAP_API_KEY=
