# Real values live in ~/.ao/data/env/credit-card/mobile.env.local and are linked
# into apps/mobile/.env.local by scripts/setup-local-env.sh (see README, "Local settings").

# Supabase (the shared project's URL and anon key; for a local stack, use the
# `npx supabase start` output instead)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# NorthTap public API (apps/api)
# EXPO_PUBLIC_NORTHTAP_API_KEY is a standard-tier client key (public in the
# binary). It must hash-match the mobile/standard row in
# supabase/migrations/*_seed_catalog.sql (public.api_keys) — not an internal
# key. Do not reuse NORTHTAP_STATIC_API_KEY (server/CI only).
# Set the real value in .env.local / Vercel env vars — never commit it here.
EXPO_PUBLIC_NORTHTAP_API_URL=http://localhost:8787
EXPO_PUBLIC_NORTHTAP_API_KEY=

# Optional: legal pages linked from the "Save your wallet" sheet.
# The consent line is hidden until both are set.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
