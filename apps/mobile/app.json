{
  "expo": {
    "name": "NorthTap",
    "slug": "northtap",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "northtap",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["ios", "android", "web"],
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.northtap.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B3D2E"
      },
      "package": "com.northtap.app"
    },
    "plugins": ["expo-router"]
  }
}
