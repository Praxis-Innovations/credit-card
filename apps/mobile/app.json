{
  "expo": {
    "name": "NorthTap",
    "slug": "northtap",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "primaryColor": "#0c5c56",
    "scheme": "northtap",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["ios", "android", "web"],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/brand/favicon.png",
      "themeColor": "#0c5c56",
      "backgroundColor": "#0c5c56"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.northtap.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "NorthTap uses your location only while the app is open, to find the store you're at and use that store's card partnerships. It is never sent to NorthTap's servers."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#0c5c56"
      },
      "package": "com.northtap.app",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NorthTap uses your location only while the app is open, to find the store you're at and use that store's card partnerships. It is never sent to NorthTap's servers."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0c5c56"
        }
      ]
    ]
  }
}
