# Supabase (service role for api_keys lookup + optional catalog reads)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# When unset / empty, the API serves the in-process domain static catalog
# (same rows as the seed migration). Set to "supabase" in production.
NORTHTAP_CATALOG_SOURCE=static

# CORS — comma-separated origins, or * for any
NORTHTAP_CORS_ORIGIN=*

# Optional: plaintext API key accepted in static-catalog mode (no Supabase).
# Must hash-match a row in public.api_keys (see seed migration).
# Set the real value in .env.local / Vercel — never commit it here.
NORTHTAP_STATIC_API_KEY=

# Used only when regenerating the catalog seed SQL
# (pnpm seed:catalog). Same rule: real value in .env.local only.
NORTHTAP_SEED_API_KEY=
