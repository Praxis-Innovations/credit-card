# Supabase (service role for api_keys lookup + optional catalog reads)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# When unset / empty, the API serves the @northtap/core static catalog
# (same rows as the seed migration). Set to "supabase" in production.
NORTHTAP_CATALOG_SOURCE=static

# CORS — comma-separated origins, or * for any
NORTHTAP_CORS_ORIGIN=*

# Seeded internal key (hash lives in supabase migrations). Used by Expo via
# EXPO_PUBLIC_NORTHTAP_API_KEY. Do not commit production keys.
# Value: nt_live_northtap_expo_internal_v1_7f3a9c2e8b1d4f06
