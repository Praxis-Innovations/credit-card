# Real values live in ~/.ao/data/env/credit-card/api.env.local and are linked
# into apps/api/.env.local by scripts/setup-local-env.sh — put real values there, not here.
#
# Supabase (service role for api_keys lookup + optional catalog reads)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# When unset / empty, the API serves the in-process domain static catalog
# (same rows as the seed migration). Set to "supabase" in production.
NORTHTAP_CATALOG_SOURCE=static

# CORS — comma-separated origins, or * for any
NORTHTAP_CORS_ORIGIN=*

# Optional: plaintext API key for server/CI / static-catalog mode (no Supabase).
# Internal tier when registered from this env var. Must NOT be the same value
# as EXPO_PUBLIC_NORTHTAP_API_KEY (that key is public in the mobile binary).
# For Supabase-backed auth, insert a separate internal row in public.api_keys.
# Set the real value in .env.local / Vercel — never commit it here.
NORTHTAP_STATIC_API_KEY=

# Used only when regenerating the catalog seed SQL (mobile standard-tier hash).
# Prefer the EXPO_PUBLIC plaintext here — not the internal static key.
# Same rule: real value in .env.local only.
NORTHTAP_SEED_API_KEY=
