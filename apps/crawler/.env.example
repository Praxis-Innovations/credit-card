# apps/crawler — copy to .env.local (gitignored). These values stay in the
# crawler's own environment; never put the service role key in any app.

# Claude access is Workload Identity Federation only (no API key; an
# ANTHROPIC_API_KEY in the environment is ignored). Values come from Claude
# Console → Settings → Workload identity; see README "Claude authentication".
# Leave all of these empty and `--dry-run` still works (fetch + link collection only).
ANTHROPIC_ORGANIZATION_ID=
ANTHROPIC_FEDERATION_RULE_ID=
ANTHROPIC_SERVICE_ACCOUNT_ID=
# Only needed if the federation rule is scoped to more than one workspace.
ANTHROPIC_WORKSPACE_ID=

# Where the short-lived OIDC identity token comes from:
#   gcloud          local Mac: your gcloud login impersonates a Google service account
#   aws             local alternative: `aws sts get-web-identity-token` (AWS CLI with that command)
#   github-actions  CI: GitHub OIDC (auto-detected when the job has `id-token: write`)
#   file            a JWT at ANTHROPIC_IDENTITY_TOKEN_FILE (e.g. a mounted projected token)
CRAWLER_WIF_IDENTITY=gcloud
# gcloud: the service account to impersonate (no key file is ever created).
CRAWLER_WIF_GCP_SERVICE_ACCOUNT=
# aws: STS region for GetWebIdentityToken (default us-east-1).
# CRAWLER_WIF_AWS_REGION=us-east-1
# file: path to the identity token.
# ANTHROPIC_IDENTITY_TOKEN_FILE=

# Supabase project URL and server-side secret key (sb_secret_… or legacy
# service_role). Used to read crawl_sources / cards and write crawl_runs /
# card_findings. Optional for `--dry-run` (falls back to built-in sources and
# skips the catalog diff).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude model. Default claude-sonnet-5-5; claude-haiku-5-5 for comparison.
CRAWLER_MODEL=claude-sonnet-5-5

# Optional: override cost estimate pricing (USD per million tokens).
# CRAWLER_PRICE_INPUT_PER_MTOK=3
# CRAWLER_PRICE_OUTPUT_PER_MTOK=15
