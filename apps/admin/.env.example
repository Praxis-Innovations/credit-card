# Same Supabase project as the NorthTap app. Use the publishable key only;
# the console never needs the service-role key (every query runs as the
# signed-in admin, under RLS). Put real values in .env.local, never here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The console's own origin. OAuth redirects are built from it and every
# mutation must carry a matching Origin header.
ADMIN_ORIGIN=http://localhost:3100
