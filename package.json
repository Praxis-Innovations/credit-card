{
  "name": "northtap",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "pipeline:run": "pnpm --filter api pipeline:run",
    "pipeline:source-health": "pnpm --filter api pipeline:source-health",
    "pipeline:promote": "pnpm --filter api pipeline:promote",
    "dev:web": "pnpm --filter web dev",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:api": "pnpm --filter api dev",
    "dev:admin": "pnpm --filter admin dev",
    "seed:catalog": "node --experimental-strip-types scripts/generate-catalog-seed.ts",
    "code-health": "node scripts/code-health.mjs",
    "code-health:report": "node scripts/code-health.mjs --report",
    "code-health:baseline": "node scripts/code-health.mjs --update-baseline"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^9.30.0",
    "globals": "^17.13.0",
    "jscpd": "^5.4.1",
    "knip": "^6.41.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.14",
      "@types/react-dom": "19.0.6"
    }
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
