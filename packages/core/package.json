    "pipeline:promote": "tsx src/data-pipeline/promote.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "cheerio": "^1.2.0",
    "robots-parser": "^3.0.1"
