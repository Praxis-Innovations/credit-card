{
  "name": "@northtap/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./data-pipeline": "./src/data-pipeline/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
